# Merfit Native App - Ortam Degiskenleri
# Fiziksel telefonla (Expo Go) test icin yerel IP:
EXPO_PUBLIC_API_URL=https://api.mbfit.online

# Google ile giris/kayit (Google Cloud Console > APIs & Services > Credentials). Gizli degildir.
# Web istemcisi: ID token'in "aud" alani; backend GoogleAuth__ClientIds__0 ile ayni olmali.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=297161641192-chmkt4foln2rs11j3tj4ijrfjsk9vtsd.apps.googleusercontent.com
# iOS istemcisi: iOS'ta zorunlu; app.config.ts URL scheme'ini bundan uretir.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=297161641192-lq6b2780f7jg6prckneg6nrpo593avri.apps.googleusercontent.com