{
  "expo": {
    "name": "MB Fit",
    "slug": "MBFitNativeApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mbfitnativeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "online.mbfit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050507",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "com.anonymous.MBFitNativeApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050507",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Öğün eklerken ürün barkodunu okutmak ve yemeğinin fotoğrafını çekmek için kameranıza erişmemiz gerekiyor.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Öğününü fotoğrafla eklemek için seçtiğin yemek fotoğrafına erişmemiz gerekiyor.",
          "cameraPermission": "Öğün eklerken ürün barkodunu okutmak ve yemeğinin fotoğrafını çekmek için kameranıza erişmemiz gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#3E7BFA",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06b01f80-27fe-4d35-a012-a9f8c620cae4"
      }
    }
  }
}
